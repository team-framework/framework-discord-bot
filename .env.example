# GitHub App webhook verification
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_PORT=3008
GITHUB_WEBHOOK_PATH=/github/webhooks

# Only these repositories can send notifications.
GITHUB_REPOSITORIES=team-framework/innolive-client,team-framework/innolive-server,team-framework/innolive-ai

# Discord delivery
DISCORD_BOT_TOKEN=
# {"team-framework/innolive-client":"123456789012345678"}
DISCORD_CHANNELS_JSON={}
# [{"github":"octocat","discordUserId":"123456789012345678"}]
DISCORD_USER_MAPPINGS_JSON=[]
# Optional: explicitly mention this role when a PR opens.
DISCORD_PR_OPEN_ROLE_ID=

# /스레드-정리 Gateway command
DISCORD_TEAM_CHANNEL_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Persistent duplicate-delivery state. Keep this directory outside source control.
DELIVERY_STATE_PATH=runtime/deliveries.json

# Optional: use the host Hermes ChatGPT summary bridge instead of the API.
THREAD_SUMMARY_PROVIDER=openai
HERMES_SUMMARY_URL=http://127.0.0.1:8646/v1/responses
# Put a generated secret in .env.hermes on the server; do not use an OpenAI key.
HERMES_SUMMARY_KEY=

# Wiki proposals are opt-in. Only the server stores these credentials.
WIKI_PROPOSALS_ENABLED=false
WIKI_DISCORD_GUILD_ID=
WIKI_DISCORD_CATEGORY_IDS=1472113454914470045
WIKI_DISCORD_CHANNEL_IDS=1472113454482591922,1553638464988385431
WIKI_DISCORD_FORUM_IDS=1553645670844334152
WIKI_SERVICE_URL=http://127.0.0.1:3110
WIKI_SERVICE_KEY=
HERMES_WIKI_URL=http://127.0.0.1:8647/v1/wiki/answer
HERMES_WIKI_KEY=
WIKI_STATE_PATH=runtime/wiki-proposals.sqlite
WIKI_GITHUB_REPOSITORY=team-framework/framework-llm-wiki
WIKI_TRACKING_ISSUE=73
WIKI_GITHUB_APP_CLIENT_ID=
WIKI_GITHUB_APP_PRIVATE_KEY_PATH=
# Host path used by compose.hermes.yaml; supply --env-file ../.env when running Compose.
WIKI_GITHUB_APP_PRIVATE_KEY_HOST_PATH=/home/chaeyn/apps/framework-agent-harness-sync/private-key.pem
# Optional fallback for explicitly configured server automation; prefer the scoped App above.
WIKI_GITHUB_TOKEN=
# Daily midnight Asia/Seoul; initial catch-up uses the 24h before the latest midnight.
WIKI_SCHEDULE_ENABLED=false
WIKI_SNAPSHOT_MESSAGES=300
WIKI_SNAPSHOT_CHARS=24000
WIKI_DAILY_MESSAGES=3000
